# =============================================================================
# goal-studio — 环境变量配置
# =============================================================================
# 复制此文件为 .env 并修改相应值:
#   cp .env.example .env
#
# 注意: .env 已加入 .gitignore,不会被提交到版本库。

# ── 运行模式 ──────────────────────────────────────────────────────────────────
# dev         开发模式(默认): 认证关闭,所有 Origin 放行,日志详细
# production  生产模式: 强制认证,Origin 白名单,日志结构化
GOAL_STUDIO_ENV=dev

# ── 认证 ──────────────────────────────────────────────────────────────────────
# API Token (Bearer). 生产模式下必须设置,否则所有请求被拒绝。
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
# GOAL_STUDIO_API_TOKEN=

# CORS 允许的 Origin (逗号分隔)。生产模式下 WebSocket 也受此限制。
# 默认: http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# GOAL_STUDIO_CORS_ORIGINS=http://localhost:8000,http://example.com

# R5-12: Metrics 端点独立 token(可选,用于 Prometheus 抓取)
# 未设置时回退到 GOAL_STUDIO_API_TOKEN
GOAL_STUDIO_METRICS_TOKEN=

# ── 存储路径 ──────────────────────────────────────────────────────────────────
# 会话数据存储根目录(默认: ~/.goal-studio/sessions)
# GOAL_STUDIO_SESSION_ROOT=/data/sessions

# Web 前端构建产物目录(容器部署时固定路径, 源码模式自动发现)
# 默认: packages/goal-studio-web/dist-app (源码相对路径)
# GOAL_STUDIO_WEB_DIST=/app/packages/goal-studio-web/dist-app

# 产物(Artifact)存储根目录(默认: ./artifacts)
# GOAL_STUDIO_ARTIFACT_ROOT=/data/artifacts

# ── LLM 配置 ──────────────────────────────────────────────────────────────────
# Provider: mock | openai | anthropic (默认 mock)
# GOAL_STUDIO_LLM_PROVIDER=mock
# GOAL_STUDIO_LLM_MODEL=gpt-4o-mini

# OpenAI / 兼容 API
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ── 性能与调试 ────────────────────────────────────────────────────────────────
# Pipeline 缓存 TTL (秒, 默认 1800)
# GOAL_STUDIO_PIPELINE_TTL=1800

# 日志级别 (DEBUG | INFO | WARNING | ERROR, 默认 INFO)
# GOAL_STUDIO_LOG_LEVEL=INFO

# 额外插件目录(逗号分隔, 默认: 自动探测 ~/.maxfun/skills 等)
# GOAL_STUDIO_PLUGIN_DIRS=/path/to/plugins

# ── 前端(Vite) ────────────────────────────────────────────────────────────────
# 注意: 前端 API Token 应通过登录流程获取,不内嵌到构建产物(VITE_* 变量会被打包进前端 bundle,存在泄露风险)
# API 基础地址(默认 http://127.0.0.1:8000/api)
# VITE_GOAL_STUDIO_API_BASE=http://127.0.0.1:8000/api
